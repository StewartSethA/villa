--- /dev/null
+++ b/volume-cartographer/core/src/TracerSelfCollision.hpp
@@ -0,0 +1,441 @@
+// In-solve self-collision prevention for the GrowPatch tracer (header-only).
+//
+// The tracer has no test of the growing surface against ITSELF. This guard adds one, with the
+// SAME definition of a defect as the shipped census (vc_tifxyz_selfcross): a non-adjacent
+// TRANSVERSE triangle-triangle contact, both diagonals of every quad, float32 coordinates,
+// maxedge-filtered quads. It reuses vc_selfcross::tri_tri verbatim; coplanar / grazing contacts
+// (two wraps pressed together) are never a rejection reason.
+//
+// Mechanism (all sequential, deterministic; the parallel solve only READS the committed state):
+//   * a uniform-grid hash of every valid quad's bounding box (cell = `cell` voxels);
+//   * a committed snapshot `snap` of every vertex position as of the end of the previous generation;
+//   * at the end of each generation `resolve()` collects the DIRTY vertices (new this generation, or
+//     moved by any solve since the snapshot), refreshes their incident quads in the hash, and tests
+//     each against the hash. A conflicting NEW vertex is rejected (state = PROCESSING|FAIL, point
+//     reset to (-1,-1,-1), never retried: the frontier does not grind on it); a conflict whose only
+//     dirty culprits are OLD moved vertices is rolled back to the snapshot (rollback of moved
+//     vertices; D3 never shrinks the surface, it only declines an unsafe move). Repeat to a fixpoint.
+//   * optional SOFT term (`weight` > 0): near-point repulsion against the nearest point of every
+//     non-lattice-neighbour quad closer than `clearance` voxels (see nearest_points()).
+//
+// Default OFF: nothing in this file runs unless params.json has self_collision.enabled = true.
+#pragma once
+
+#include "../../apps/src/vc_tifxyz_selfcross_impl.hpp"
+
+#include <opencv2/core/mat.hpp>
+#include <opencv2/core/matx.hpp>
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <unordered_map>
+#include <vector>
+
+namespace vc_selfcoll {
+
+struct Params {
+    bool enabled = false;
+    bool hard = true;          // hard candidate rejection + moved-vertex rollback
+    double clearance = 3.0;    // voxels; soft term only
+    int k = 1;                 // lattice (Chebyshev) exclusion for the HARD test; 1 == detector default
+    int soft_k = 3;            // lattice exclusion for the soft term
+    double weight = 0.0;       // soft residual weight; 0 = no soft term
+    double maxedge = 60.0;     // voxels; quads with a longer edge are not tested (detector default)
+    double cell = 40.0;        // hash cell, voxels
+    int window = 10;           // dirty-scan half-window around each new vertex (local solves reach radius 8)
+    int max_iter = 1000;   // safety only: every pass kills >= 1 alive dirty vertex, so the fixpoint terminates; hitting this is announced
+};
+
+struct Stats {
+    long gens = 0, dirty = 0, dirty_new = 0, dirty_moved = 0;
+    long quads_tested = 0, pairs_tested = 0, crossings = 0;
+    long rejected_new = 0, reverted_moved = 0, iter_cap_hits = 0;
+    double seconds = 0;
+};
+
+struct Cand { int i, j; };
+
+class Guard {
+public:
+    using Vec3 = vc_selfcross::Vec3;
+    Params prm;
+    Stats st;
+
+    Guard(const Params& p, cv::Mat_<cv::Vec3d>& pts, cv::Mat_<uint8_t>& state)
+        : prm(p), P_(&pts), S_(&state) {
+        snap_ = pts.clone();
+        mark_ = cv::Mat_<uint8_t>(pts.size(), (uint8_t)0);
+        rows_ = pts.rows; cols_ = pts.cols;
+        for (int i = 0; i + 1 < rows_; ++i)
+            for (int j = 0; j + 1 < cols_; ++j)
+                if (vert_ok(i, j) && vert_ok(i + 1, j) && vert_ok(i, j + 1) && vert_ok(i + 1, j + 1))
+                    register_quad(i, j);
+    }
+
+    // ---- committed (thread-safe to read during the parallel solve) --------------------------------
+    // Nearest points on non-lattice-neighbour committed quads within `radius` of position x for vertex (vi,vj).
+    // Reads only hash + snap, which change solely inside resolve() (sequential).
+    int nearest_points(const cv::Vec3d& x, int vi, int vj, double radius, int max_pts,
+                       std::array<cv::Vec3d, 4>& out) const {
+        const double r = radius;
+        int c0[3], c1[3];
+        for (int a = 0; a < 3; ++a) { c0[a] = cell_of(x[a] - r); c1[a] = cell_of(x[a] + r); }
+        std::vector<uint32_t> ids;
+        for (int k = c0[2]; k <= c1[2]; ++k)
+            for (int j = c0[1]; j <= c1[1]; ++j)
+                for (int i = c0[0]; i <= c1[0]; ++i) {
+                    auto it = cells_.find(key(i, j, k));
+                    if (it != cells_.end()) ids.insert(ids.end(), it->second.begin(), it->second.end());
+                }
+        std::sort(ids.begin(), ids.end());
+        ids.erase(std::unique(ids.begin(), ids.end()), ids.end());
+        struct Hit { double d2; cv::Vec3d q; };
+        std::vector<Hit> hits;
+        const int K = prm.soft_k;
+        for (uint32_t id : ids) {
+            const int qi = (int)(id / (uint32_t)cols_), qj = (int)(id % (uint32_t)cols_);
+            if (qi >= vi - K - 1 && qi <= vi + K && qj >= vj - K - 1 && qj <= vj + K) continue;
+            Vec3 c[4];
+            if (!quad_pts_snap(qi, qj, c)) continue;
+            const Vec3 xx{x[0], x[1], x[2]};
+            const Vec3 tri[2][3] = {{c[0], c[1], c[3]}, {c[0], c[3], c[2]}};
+            for (int t = 0; t < 2; ++t) {
+                Vec3 q = closest_on_tri(xx, tri[t][0], tri[t][1], tri[t][2]);
+                Vec3 d = q - xx;
+                double d2 = vc_selfcross::dot(d, d);
+                if (d2 < r * r) hits.push_back({d2, cv::Vec3d(q.x, q.y, q.z)});
+            }
+        }
+        std::sort(hits.begin(), hits.end(), [](const Hit& a, const Hit& b) { return a.d2 < b.d2; });
+        int n = std::min<int>((int)hits.size(), std::min(max_pts, 4));
+        for (int t = 0; t < n; ++t) out[t] = hits[t].q;
+        return n;
+    }
+
+    // ---- sequential end-of-generation resolution ------------------------------------------------
+    // new_pts: vertices that became valid this generation. full: scan the whole grid for moved vertices
+    // (global-optimisation generations). Returns the vertices that were REJECTED (caller must drop them
+    // from fringe / counters). Modifies P (reverts, rejects), S (rejects).
+    std::vector<cv::Vec2i> resolve(const std::vector<cv::Vec2i>& new_pts, bool full) {
+        const double t0 = now();
+        ++st.gens;
+        cv::Mat_<cv::Vec3d>& P = *P_;
+        cv::Mat_<uint8_t>& S = *S_;
+        std::vector<cv::Vec2i> rejected;
+
+        // 1. dirty set
+        std::vector<cv::Vec2i> dirty;
+        std::vector<uint8_t> is_new;
+        auto consider = [&](int i, int j, bool nw) {
+            if (i < 0 || j < 0 || i >= rows_ || j >= cols_) return;
+            uint8_t& m = mark_(i, j);
+            if (m) { if (nw && m == 1) { m = 2; } return; }
+            if (!(S(i, j) & STATE_LOC_VALID_)) return;
+            if (!nw && P(i, j) == snap_(i, j)) return;
+            m = nw ? 2 : 1;
+            dirty.push_back({i, j});
+        };
+        for (const auto& p : new_pts) consider(p[0], p[1], true);
+        if (full) {
+            for (int i = 0; i < rows_; ++i) for (int j = 0; j < cols_; ++j) consider(i, j, false);
+        } else {
+            for (const auto& p : new_pts)
+                for (int di = -prm.window; di <= prm.window; ++di)
+                    for (int dj = -prm.window; dj <= prm.window; ++dj)
+                        consider(p[0] + di, p[1] + dj, false);
+        }
+        // is_new from marks; deterministic order
+        std::sort(dirty.begin(), dirty.end(), [](const cv::Vec2i& a, const cv::Vec2i& b) {
+            return a[0] != b[0] ? a[0] < b[0] : a[1] < b[1]; });
+        for (const auto& d : dirty) {
+            const bool nw = mark_(d[0], d[1]) == 2;
+            is_new.push_back(nw);
+            nw ? ++st.dirty_new : ++st.dirty_moved;
+        }
+        st.dirty += (long)dirty.size();
+        if (!prm.hard) {
+            // soft-only: just commit
+            for (const auto& d : dirty) { snap_(d[0], d[1]) = P(d[0], d[1]); mark_(d[0], d[1]) = 0; }
+            refresh_incident(dirty);
+            st.seconds += now() - t0;
+            return rejected;
+        }
+
+        auto dirty_idx = [&](int i, int j) -> int {   // binary search in the sorted dirty list
+            auto it = std::lower_bound(dirty.begin(), dirty.end(), cv::Vec2i(i, j),
+                [](const cv::Vec2i& a, const cv::Vec2i& b) { return a[0] != b[0] ? a[0] < b[0] : a[1] < b[1]; });
+            if (it != dirty.end() && (*it)[0] == i && (*it)[1] == j) return (int)(it - dirty.begin());
+            return -1;
+        };
+        std::vector<uint8_t> alive(dirty.size(), 1);
+
+        // 2. refresh hash for the incident quads of all dirty vertices
+        refresh_incident(dirty);
+
+        // 3. fixpoint
+        for (int iter = 0;; ++iter) {
+            std::vector<uint32_t> qs = incident_quads(dirty, alive);
+            struct Conf { int qi, qj, ri, rj; };
+            std::vector<Conf> conf;
+            for (uint32_t q : qs) {
+                const int qi = (int)(q / (uint32_t)cols_), qj = (int)(q % (uint32_t)cols_);
+                ++st.quads_tested;
+                std::vector<uint32_t> others = query(qi, qj);
+                for (uint32_t o : others) {
+                    const int oi = (int)(o / (uint32_t)cols_), oj = (int)(o % (uint32_t)cols_);
+                    if (std::abs(oi - qi) <= prm.k && std::abs(oj - qj) <= prm.k) continue;
+                    ++st.pairs_tested;
+                    if (quads_cross(qi, qj, oi, oj)) conf.push_back({qi, qj, oi, oj});
+                }
+            }
+            if (conf.empty()) break;
+            if (iter >= prm.max_iter) { ++st.iter_cap_hits; std::fprintf(stderr, "self_collision: ANNOUNCE iteration safety cap %d hit with %zu unresolved conflicts\n", prm.max_iter, conf.size()); break; }
+            st.crossings += (long)conf.size();
+            // culprits: alive dirty corners of both quads of each conflicting pair
+            std::vector<int> cul_new, cul_moved;
+            auto add_corners = [&](int qi, int qj) {
+                for (int di = 0; di < 2; ++di) for (int dj = 0; dj < 2; ++dj) {
+                    int idx = dirty_idx(qi + di, qj + dj);
+                    if (idx >= 0 && alive[idx]) (is_new[idx] ? cul_new : cul_moved).push_back(idx);
+                }
+            };
+            for (const auto& c : conf) { add_corners(c.qi, c.qj); add_corners(c.ri, c.rj); }
+            auto uniq = [](std::vector<int>& v) { std::sort(v.begin(), v.end()); v.erase(std::unique(v.begin(), v.end()), v.end()); };
+            uniq(cul_new); uniq(cul_moved);
+            std::vector<int> act;
+            if (!cul_new.empty()) {
+                // reject new vertices first; moved vertices are only reverted if a conflict survives
+                for (int idx : cul_new) {
+                    const cv::Vec2i d = dirty[idx];
+                    reject(d);
+                    rejected.push_back(d);
+                    alive[idx] = 0;
+                    act.push_back(idx);
+                    ++st.rejected_new;
+                }
+            } else {
+                for (int idx : cul_moved) {
+                    const cv::Vec2i d = dirty[idx];
+                    P(d[0], d[1]) = snap_(d[0], d[1]);
+                    alive[idx] = 0;      // back at its committed position: no longer dirty
+                    act.push_back(idx);
+                    ++st.reverted_moved;
+                }
+            }
+            std::vector<cv::Vec2i> touched;
+            for (int idx : act) touched.push_back(dirty[idx]);
+            refresh_incident(touched);
+        }
+        // 4. commit
+        for (size_t t = 0; t < dirty.size(); ++t) {
+            const auto& d = dirty[t];
+            snap_(d[0], d[1]) = P(d[0], d[1]);   // rejected: (-1,-1,-1); reverted: already equal
+            mark_(d[0], d[1]) = 0;
+        }
+        st.seconds += now() - t0;
+        return rejected;
+    }
+
+    void print_summary(const char* tag = "self_collision") const {
+        std::printf("%s: gens %ld dirty %ld (new %ld moved %ld) quads_tested %ld pairs_tested %ld "
+                    "crossings_found %ld rejected_new %ld reverted_moved %ld iter_cap_hits %ld guard_s %.2f\n",
+                    tag, st.gens, st.dirty, st.dirty_new, st.dirty_moved, st.quads_tested, st.pairs_tested,
+                    st.crossings, st.rejected_new, st.reverted_moved, st.iter_cap_hits, st.seconds);
+    }
+
+    // exposed for tests / the harness: does quad (qi,qj) transversally cross any non-adjacent quad?
+    bool quad_has_crossing(int qi, int qj) {
+        for (uint32_t o : query(qi, qj)) {
+            const int oi = (int)(o / (uint32_t)cols_), oj = (int)(o % (uint32_t)cols_);
+            if (std::abs(oi - qi) <= prm.k && std::abs(oj - qj) <= prm.k) continue;
+            if (quads_cross(qi, qj, oi, oj)) return true;
+        }
+        return false;
+    }
+
+private:
+    static constexpr int STATE_LOC_VALID_ = 1;
+    static constexpr int STATE_PROCESSING_ = 2;
+    static constexpr int STATE_FAIL_ = 8;
+
+    cv::Mat_<cv::Vec3d>* P_;
+    cv::Mat_<uint8_t>* S_;
+    cv::Mat_<cv::Vec3d> snap_;
+    cv::Mat_<uint8_t> mark_;
+    int rows_ = 0, cols_ = 0;
+    std::unordered_map<uint64_t, std::vector<uint32_t>> cells_;
+    std::unordered_map<uint32_t, std::array<int32_t, 6>> reg_;
+
+    static double now() {
+        return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+
+    int cell_of(double x) const { return (int)std::floor(x / prm.cell); }
+    static uint64_t key(int i, int j, int k) {
+        const uint64_t OFF = 1u << 19;
+        return ((uint64_t)(k + OFF) << 42) | ((uint64_t)(j + OFF) << 21) | (uint64_t)(i + OFF);
+    }
+
+    bool vert_ok(int i, int j) const {
+        if (i < 0 || j < 0 || i >= rows_ || j >= cols_) return false;
+        if (!((*S_)(i, j) & STATE_LOC_VALID_)) return false;
+        const cv::Vec3d& p = (*P_)(i, j);
+        return p[0] != -1.0;
+    }
+
+    void reject(const cv::Vec2i& d) {
+        (*S_)(d[0], d[1]) = (uint8_t)(STATE_PROCESSING_ | STATE_FAIL_);
+        (*P_)(d[0], d[1]) = cv::Vec3d(-1, -1, -1);
+    }
+
+    // float32 corners, exactly as the saved tifxyz would hold them
+    bool quad_pts_from(const cv::Mat_<cv::Vec3d>& M, int i, int j, Vec3 c[4], bool check_state) const {
+        if (i < 0 || j < 0 || i + 1 >= rows_ || j + 1 >= cols_) return false;
+        const int di[4] = {0, 0, 1, 1}, dj[4] = {0, 1, 0, 1};   // p00 p01 p10 p11
+        for (int t = 0; t < 4; ++t) {
+            if (check_state && !vert_ok(i + di[t], j + dj[t])) return false;
+            const cv::Vec3d& p = M(i + di[t], j + dj[t]);
+            if (p[0] == -1.0) return false;
+            c[t] = Vec3{(double)(float)p[0], (double)(float)p[1], (double)(float)p[2]};
+        }
+        if (prm.maxedge > 0) {
+            const Vec3 &p00 = c[0], &p01 = c[1], &p10 = c[2], &p11 = c[3];
+            double e = std::max(std::max(vc_selfcross::norm(p01 - p00), vc_selfcross::norm(p11 - p01)),
+                       std::max(std::max(vc_selfcross::norm(p10 - p11), vc_selfcross::norm(p00 - p10)),
+                                std::max(vc_selfcross::norm(p11 - p00), vc_selfcross::norm(p10 - p01))));
+            if (e > prm.maxedge) return false;
+        }
+        return true;
+    }
+    bool quad_pts(int i, int j, Vec3 c[4]) const { return quad_pts_from(*P_, i, j, c, true); }
+    bool quad_pts_snap(int i, int j, Vec3 c[4]) const { return quad_pts_from(snap_, i, j, c, false); }
+
+    void unregister_quad(uint32_t id) {
+        auto it = reg_.find(id);
+        if (it == reg_.end()) return;
+        const auto& r = it->second;
+        for (int k = r[2]; k <= r[5]; ++k) for (int j = r[1]; j <= r[4]; ++j) for (int i = r[0]; i <= r[3]; ++i) {
+            auto c = cells_.find(key(i, j, k));
+            if (c == cells_.end()) continue;
+            auto& v = c->second;
+            auto f = std::find(v.begin(), v.end(), id);
+            if (f != v.end()) { *f = v.back(); v.pop_back(); }
+            if (v.empty()) cells_.erase(c);
+        }
+        reg_.erase(it);
+    }
+    void register_quad(int i, int j) {
+        const uint32_t id = (uint32_t)i * (uint32_t)cols_ + (uint32_t)j;
+        unregister_quad(id);
+        Vec3 c[4];
+        if (!quad_pts(i, j, c)) return;
+        double lo[3] = {1e30, 1e30, 1e30}, hi[3] = {-1e30, -1e30, -1e30};
+        for (int t = 0; t < 4; ++t) {
+            const double v[3] = {c[t].x, c[t].y, c[t].z};
+            for (int a = 0; a < 3; ++a) { lo[a] = std::min(lo[a], v[a]); hi[a] = std::max(hi[a], v[a]); }
+        }
+        std::array<int32_t, 6> r;
+        for (int a = 0; a < 3; ++a) {
+            r[a] = cell_of(lo[a] - vc_selfcross::TOUCH_TOL);
+            r[3 + a] = cell_of(hi[a] + vc_selfcross::TOUCH_TOL);
+        }
+        for (int k = r[2]; k <= r[5]; ++k) for (int j2 = r[1]; j2 <= r[4]; ++j2) for (int i2 = r[0]; i2 <= r[3]; ++i2)
+            cells_[key(i2, j2, k)].push_back(id);
+        reg_[id] = r;
+    }
+    void refresh_incident(const std::vector<cv::Vec2i>& vs) {
+        for (const auto& v : vs)
+            for (int a = -1; a <= 0; ++a) for (int b = -1; b <= 0; ++b) {
+                const int qi = v[0] + a, qj = v[1] + b;
+                if (qi >= 0 && qj >= 0 && qi + 1 < rows_ && qj + 1 < cols_) register_quad(qi, qj);
+            }
+    }
+    std::vector<uint32_t> incident_quads(const std::vector<cv::Vec2i>& vs, const std::vector<uint8_t>& alive) const {
+        std::vector<uint32_t> q;
+        for (size_t t = 0; t < vs.size(); ++t) {
+            if (!alive[t]) continue;
+            for (int a = -1; a <= 0; ++a) for (int b = -1; b <= 0; ++b) {
+                const int qi = vs[t][0] + a, qj = vs[t][1] + b;
+                if (qi >= 0 && qj >= 0 && qi + 1 < rows_ && qj + 1 < cols_ && reg_.count((uint32_t)qi * (uint32_t)cols_ + (uint32_t)qj))
+                    q.push_back((uint32_t)qi * (uint32_t)cols_ + (uint32_t)qj);
+            }
+        }
+        std::sort(q.begin(), q.end());
+        q.erase(std::unique(q.begin(), q.end()), q.end());
+        return q;
+    }
+    std::vector<uint32_t> query(int qi, int qj) const {
+        std::vector<uint32_t> out;
+        auto it = reg_.find((uint32_t)qi * (uint32_t)cols_ + (uint32_t)qj);
+        if (it == reg_.end()) return out;
+        const auto& r = it->second;
+        for (int k = r[2]; k <= r[5]; ++k) for (int j = r[1]; j <= r[4]; ++j) for (int i = r[0]; i <= r[3]; ++i) {
+            auto c = cells_.find(key(i, j, k));
+            if (c != cells_.end()) out.insert(out.end(), c->second.begin(), c->second.end());
+        }
+        std::sort(out.begin(), out.end());
+        out.erase(std::unique(out.begin(), out.end()), out.end());
+        const uint32_t self = (uint32_t)qi * (uint32_t)cols_ + (uint32_t)qj;
+        out.erase(std::remove(out.begin(), out.end(), self), out.end());
+        return out;
+    }
+
+    bool quads_cross(int ai, int aj, int bi, int bj) const {
+        Vec3 A[4], B[4];
+        if (!quad_pts(ai, aj, A) || !quad_pts(bi, bj, B)) return false;
+        for (int diag = 0; diag < 2; ++diag) {
+            vc_selfcross::Tri ta[2], tb[2];
+            fill(A, diag, ta); fill(B, diag, tb);
+            for (int x = 0; x < 2; ++x) for (int y = 0; y < 2; ++y)
+                if (vc_selfcross::tri_tri(ta[x], tb[y]).verdict == vc_selfcross::TRANSVERSE) return true;
+        }
+        return false;
+    }
+    static void fill(const Vec3 c[4], int diag, vc_selfcross::Tri t[2]) {
+        const Vec3 &p00 = c[0], &p01 = c[1], &p10 = c[2], &p11 = c[3];
+        if (diag == 0) { t[0] = {p00, p01, p11, 0, 0, 0}; t[1] = {p00, p11, p10, 0, 0, 1}; }
+        else           { t[0] = {p00, p01, p10, 0, 0, 0}; t[1] = {p01, p11, p10, 0, 0, 1}; }
+    }
+
+    // Ericson, Real-Time Collision Detection 5.1.5
+    static Vec3 closest_on_tri(const Vec3& p, const Vec3& a, const Vec3& b, const Vec3& c) {
+        using vc_selfcross::dot;
+        Vec3 ab = b - a, ac = c - a, ap = p - a;
+        double d1 = dot(ab, ap), d2 = dot(ac, ap);
+        if (d1 <= 0 && d2 <= 0) return a;
+        Vec3 bp = p - b; double d3 = dot(ab, bp), d4 = dot(ac, bp);
+        if (d3 >= 0 && d4 <= d3) return b;
+        double vc = d1 * d4 - d3 * d2;
+        if (vc <= 0 && d1 >= 0 && d3 <= 0) return a + ab * (d1 / (d1 - d3));
+        Vec3 cp = p - c; double d5 = dot(ab, cp), d6 = dot(ac, cp);
+        if (d6 >= 0 && d5 <= d6) return c;
+        double vb = d5 * d2 - d1 * d6;
+        if (vb <= 0 && d2 >= 0 && d6 <= 0) return a + ac * (d2 / (d2 - d6));
+        double va = d3 * d6 - d5 * d4;
+        if (va <= 0 && (d4 - d3) >= 0 && (d5 - d6) >= 0)
+            return b + (c - b) * ((d4 - d3) / ((d4 - d3) + (d5 - d6)));
+        double den = 1.0 / (va + vb + vc);
+        return a + ab * (vb * den) + ac * (vc * den);
+    }
+};
+
+// Soft residual: w * max(0, clearance - |x - q|), q a constant nearest point on a non-neighbour quad.
+struct SelfRepelCost {
+    SelfRepelCost(const cv::Vec3d& q, double c, double w) : q_(q), c_(c), w_(w) {}
+    template <typename T>
+    bool operator()(const T* x, T* r) const {
+        using std::sqrt;
+        T d2 = (x[0] - q_[0]) * (x[0] - q_[0]) + (x[1] - q_[1]) * (x[1] - q_[1]) + (x[2] - q_[2]) * (x[2] - q_[2]);
+        if (d2 >= c_ * c_) { r[0] = T(0.0); return true; }
+        r[0] = T(w_) * (T(c_) - sqrt(d2 + T(1e-12)));
+        return true;
+    }
+    cv::Vec3d q_;
+    double c_, w_;
+};
+
+}  // namespace vc_selfcoll
