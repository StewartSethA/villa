+// Fixtures for the in-solve self-collision guard (core/src/TracerSelfCollision.hpp).
+//
+// Each fixture states the trap it exists to pin down. The central one is COUNTERFACTUAL: the same
+// synthetic folding sheet is censused WITHOUT the guard (must show transverse crossings, i.e. this test
+// is seen to fail first) and WITH it (must show none, using the shipped census kernel as the judge).
+
+#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN
+#include "vc_test.hpp"
+
+#include "../src/TracerSelfCollision.hpp"
+
+#include <opencv2/core/mat.hpp>
+
+#include <vector>
+
+using vc_selfcoll::Guard;
+using vc_selfcoll::Params;
+
+namespace {
+
+constexpr uint8_t VALID = 1;
+
+struct Grid {
+    cv::Mat_<cv::Vec3d> P;
+    cv::Mat_<uint8_t> S;
+    explicit Grid(int r, int c) : P(r, c, cv::Vec3d(-1, -1, -1)), S(r, c, (uint8_t)0) {}
+    void set(int i, int j, double x, double y, double z) { P(i, j) = {x, y, z}; S(i, j) = VALID; }
+    cv::Mat_<cv::Vec3f> asF() const {
+        cv::Mat_<cv::Vec3f> F(P.size(), cv::Vec3f(-1, -1, -1));
+        for (int i = 0; i < P.rows; ++i)
+            for (int j = 0; j < P.cols; ++j)
+                if ((S(i, j) & VALID) && P(i, j)[0] != -1.0) F(i, j) = cv::Vec3f(P(i, j));
+        return F;
+    }
+    size_t transverse() const {
+        std::vector<vc_selfcross::Contact> out;
+        size_t n = 0;
+        for (int d = 0; d < 2; ++d) {
+            out.clear();
+            n += vc_selfcross::census(asF(), d, 40.0, 1, 60.0, 1, out).transverse;
+        }
+        return n;
+    }
+    int nvalid() const { int n = 0; for (int i = 0; i < S.rows; ++i) for (int j = 0; j < S.cols; ++j) n += (S(i, j) & VALID) != 0; return n; }
+};
+
+constexpr int COLS = 12;
+constexpr double H = 10.0;   // lattice spacing, voxels
+
+// rows 0..9: flat sheet z=0. Rows 10..15 then fold back OVER it and through it: row 10 lies above the sheet
+// (z=+2), rows 11.. below it (z = 2 - 6*(r-10)), all at y = 87 - 15*(r-9) < 90 (offset 3 so the crossing is not exactly on a mesh edge row) i.e. over the sheet, so the quads
+// between rows 10 and 11 pierce the z=0 plane in the interior of the flat sheet.
+void fill_flat(Grid& g, int rows) {
+    for (int i = 0; i < rows; ++i) for (int j = 0; j < COLS; ++j) g.set(i, j, H * j, H * i, 0.0);
+}
+void fill_fold_row(Grid& g, int r) {
+    for (int j = 0; j < COLS; ++j) g.set(r, j, H * j, 87.0 - 15.0 * (r - 9), 2.0 - 6.0 * (r - 10));
+}
+
+Params on() { Params p; p.enabled = true; return p; }
+
+}  // namespace
+
+TEST_CASE("fixture self-check: the folding sheet really crosses without the guard") {
+    Grid g(16, COLS);
+    fill_flat(g, 10);
+    CHECK(g.transverse() == 0);
+    for (int r = 10; r < 16; ++r) fill_fold_row(g, r);
+    CHECK(g.transverse() > 0);   // this is the assertion that fails first if the fixture is wrong
+}
+
+TEST_CASE("hard guard keeps a folding sheet crossing-free") {
+    Grid g(16, COLS);
+    fill_flat(g, 10);
+    Guard guard(on(), g.P, g.S);
+    int rejected = 0;
+    for (int r = 10; r < 16; ++r) {
+        fill_fold_row(g, r);
+        std::vector<cv::Vec2i> nw;
+        for (int j = 0; j < COLS; ++j) nw.push_back({r, j});
+        rejected += (int)guard.resolve(nw, false).size();
+        CHECK(g.transverse() == 0);          // judged by the shipped census, after EVERY generation
+    }
+    CHECK(rejected > 0);                      // the guard acted
+    CHECK(g.nvalid() < 16 * COLS);            // and those cells are really gone from the state
+    for (int i = 0; i < 16; ++i) for (int j = 0; j < COLS; ++j)
+        if (!(g.S(i, j) & VALID)) CHECK(g.P(i, j)[0] == -1.0);   // rejected points reset (never saved as valid)
+    for (int i = 0; i < 10; ++i) for (int j = 0; j < COLS; ++j) CHECK(g.S(i, j) == VALID);   // D3: old cells kept
+}
+
+TEST_CASE("a benign growing sheet is never rejected (no false rejections)") {
+    Grid g(16, COLS);
+    fill_flat(g, 4);
+    Guard guard(on(), g.P, g.S);
+    for (int r = 4; r < 16; ++r) {
+        for (int j = 0; j < COLS; ++j) g.set(r, j, H * j, H * r, 0.2 * std::sin(0.3 * r + 0.2 * j));
+        std::vector<cv::Vec2i> nw;
+        for (int j = 0; j < COLS; ++j) nw.push_back({r, j});
+        CHECK(guard.resolve(nw, false).empty());
+    }
+    CHECK(guard.st.rejected_new == 0);
+    CHECK(g.nvalid() == 16 * COLS);
+}
+
+TEST_CASE("coplanar contact between wraps is NOT a rejection reason, nor is plain proximity") {
+    // sheet A rows 0..5 at z=0; sheet B (rows 9..14, a gap of invalid rows between) grown afterwards.
+    for (double dz : {0.0, 1.5}) {   // 0.0: pressed flat (coplanar); 1.5: parallel and close, no contact
+        Grid g(16, COLS);
+        for (int i = 0; i < 6; ++i) for (int j = 0; j < COLS; ++j) g.set(i, j, H * j, H * i, 0.0);
+        Guard guard(on(), g.P, g.S);
+        for (int i = 9; i < 15; ++i) {
+            for (int j = 0; j < COLS; ++j) g.set(i, j, H * j, H * (i - 9), dz);
+        }
+        std::vector<cv::Vec2i> nw;
+        for (int i = 9; i < 15; ++i) for (int j = 0; j < COLS; ++j) nw.push_back({i, j});
+        CHECK(guard.resolve(nw, false).empty());
+        CHECK(guard.st.rejected_new == 0);
+        CHECK(g.transverse() == 0);
+    }
+}
+
+TEST_CASE("a MOVED old vertex that would cross is rolled back to its committed position") {
+    Grid g(16, COLS);
+    for (int i = 0; i < 6; ++i) for (int j = 0; j < COLS; ++j) g.set(i, j, H * j, H * i, 0.0);          // sheet A, z = 0
+    for (int i = 9; i < 15; ++i) for (int j = 0; j < COLS; ++j) g.set(i, j, H * j, H * (i - 9), 6.0);   // sheet B, z = 6
+    Guard guard(on(), g.P, g.S);
+    CHECK(g.transverse() == 0);
+    const cv::Vec3d before = g.P(3, 5);
+    g.P(3, 5) = cv::Vec3d(H * 5, H * 3, 12.0);    // a solve drives a sheet-A vertex up through sheet B
+    CHECK(g.transverse() > 0);                      // fixture check: the unguarded move does cross
+    auto rej = guard.resolve({}, true);   // full scan: no new vertices to centre a window on
+    CHECK(rej.empty());                              // an old vertex is never deleted (D3) ...
+    CHECK(g.P(3, 5) == before);                      // ... only declined
+    CHECK(g.S(3, 5) == VALID);
+    CHECK(guard.st.reverted_moved >= 1);
+    CHECK(g.transverse() == 0);
+}
+
+TEST_CASE("a moved old vertex that does not cross is committed, not reverted") {
+    Grid g(16, COLS);
+    for (int i = 0; i < 6; ++i) for (int j = 0; j < COLS; ++j) g.set(i, j, H * j, H * i, 0.0);
+    Guard guard(on(), g.P, g.S);
+    g.P(3, 5) = cv::Vec3d(H * 5 + 1.0, H * 3 - 1.0, 0.5);
+    const cv::Vec3d moved = g.P(3, 5);
+    guard.resolve({}, true);
+    CHECK(g.P(3, 5) == moved);
+    CHECK(guard.st.reverted_moved == 0);
+}
+
+TEST_CASE("soft term: nearest points ignore lattice neighbours and respect the clearance") {
+    Grid g(16, COLS);
+    for (int i = 0; i < 6; ++i) for (int j = 0; j < COLS; ++j) g.set(i, j, H * j, H * i, 0.0);          // z = 0
+    for (int i = 9; i < 15; ++i) for (int j = 0; j < COLS; ++j) g.set(i, j, H * j, H * (i - 9), 2.0);   // z = 2
+    Params p = on(); p.weight = 1.0; p.clearance = 3.0;
+    Guard guard(p, g.P, g.S);
+    std::array<cv::Vec3d, 4> q;
+    // vertex (10,5) of sheet B: sheet A is 2 voxels away (< 3) and not a lattice neighbour
+    int n = guard.nearest_points(g.P(10, 5), 10, 5, 3.0, 4, q);
+    CHECK(n >= 1);
+    CHECK(std::abs(q[0][2]) < 1e-9);
+    // its own sheet (only 2 rows away: inside soft_k = 3) must not count
+    n = guard.nearest_points(g.P(10, 5), 10, 5, 0.5, 4, q);
+    CHECK(n == 0);
+}
